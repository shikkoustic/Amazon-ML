# Data — never commit competition data
data/
# Kernel outputs pulled from Kaggle: gigabytes of candidates, plus the .npz
# shards and run logs beside them. Regenerable from the kernels.
kaggle_outputs/
*.npz
!data/.gitkeep
!data/**/.gitkeep
*.csv
*.tsv
*.parquet
*.feather
*.zip
*.gz
*.7z

# Models & artifacts
models/
*.pkl
*.joblib
*.pt
*.pth
*.bin
*.onnx
submissions/*.csv
!submissions/.gitkeep

# Images / media downloads
images/
*.jpg
*.jpeg
*.png
!reports/**/*.png

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Secrets
.env
kaggle.json
*.pem
.aws/

# OS / editor
.DS_Store
.vscode/
.idea/

# profiling reports are regenerable
!reports/*.txt

# live run logs are working output, regenerable; results land in *.txt / *.json
reports/*.log

# Submission staging: code is tracked at source, outputs are gigabytes
submission/
output/

# Cross-encoder training export: regenerable from the pipeline
ce_data/
